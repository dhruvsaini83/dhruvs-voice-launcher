{
  "manifest_version": 3,
  "name": "Dhruv's Voice Launcher",
  "version": "3.0",
  "description": "Say Open + any website to launch it, and Close to close it - all hands-free.",
  "permissions": ["tabs", "storage", "alarms"],
  "optional_permissions": ["offscreen", "scripting"],
  "host_permissions": ["<all_urls>"],
  "options_page": "setup.html",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
